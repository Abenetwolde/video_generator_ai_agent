{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short.local/schema/storyboard.schema.json",
  "title": "The Heritage Short Storyboard Contract",
  "description": "Single source-of-truth contract between script, keyframes, shots, music, narration, and assembly stages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "style", "shots", "end_card", "assembly"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language",
        "narration_language",
        "subtitle_language",
        "audience",
        "intent",
        "aspect_ratios",
        "target_total_seconds",
        "fps",
        "loudness_target_lufs",
        "true_peak_db"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "proverb": { "type": "string" },
        "language": { "type": "string", "minLength": 2 },
        "narration_language": { "type": "string", "minLength": 2 },
        "subtitle_language": { "type": "string", "const": "en" },
        "audience": { "type": "string", "minLength": 5 },
        "intent": { "type": "string", "minLength": 10 },
        "aspect_ratios": {
          "type": "array",
          "items": { "type": "string", "enum": ["9:16", "16:9"] },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "target_total_seconds": { "type": "number", "minimum": 60, "maximum": 90 },
        "fps": { "type": "integer", "enum": [24] },
        "loudness_target_lufs": { "type": "number", "minimum": -16, "maximum": -12 },
        "true_peak_db": { "type": "number", "maximum": -1 }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_block",
        "negative_prompt",
        "character_sheet_refs",
        "golden_reference"
      ],
      "properties": {
        "style_block": { "type": "string", "minLength": 10 },
        "character_description": { "type": "string" },
        "negative_prompt": { "type": "string", "minLength": 3 },
        "character_sheet_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "golden_reference": { "type": "string", "minLength": 1 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "duration_s",
          "shot_size",
          "camera",
          "reason",
          "keyframe",
          "motion",
          "narration",
          "music_cue",
          "subtitles"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^shot_[0-9]{2}$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 12 },
          "duration_s": { "type": "number", "minimum": 3, "maximum": 15 },
          "shot_size": {
            "type": "string",
            "enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close", "extreme_close", "insert"]
          },
          "camera": {
            "type": "string",
            "enum": ["locked", "pan_left", "pan_right", "push_in", "pull_back", "tilt_up", "tilt_down", "slow_drift"]
          },
          "reason": { "type": "string", "minLength": 10 },
          "keyframe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "seed", "negative_prompt", "ref_images", "model"],
            "properties": {
              "prompt": { "type": "string", "minLength": 10 },
              "seed": { "type": "integer", "minimum": 0 },
              "negative_prompt": { "type": "string", "minLength": 3 },
              "ref_images": {
                "type": "array",
                "items": { "type": "string" }
              },
              "model": { "type": "string", "minLength": 3 }
            }
          },
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "seed", "model", "draft_resolution", "final_resolution"],
            "properties": {
              "prompt": { "type": "string", "minLength": 5 },
              "seed": { "type": "integer", "minimum": 0 },
              "model": { "type": "string", "minLength": 3 },
              "draft_resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$|^480p$" },
              "final_resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$|^720p$" }
            }
          },
          "narration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "style_instruction", "voice", "language"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "english_translation": { "type": "string", "minLength": 1 },
              "style_instruction": { "type": "string", "minLength": 3 },
              "voice": { "type": "string", "minLength": 2 },
              "language": { "type": "string", "minLength": 2 }
            }
          },
          "music_cue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_s",
              "end_s",
              "caption",
              "tempo_bpm",
              "key",
              "duration_s",
              "chosen_candidate_path",
              "candidates"
            ],
            "properties": {
              "start_s": { "type": "number", "minimum": 0 },
              "end_s": { "type": "number", "minimum": 1 },
              "caption": { "type": "string", "minLength": 10 },
              "tempo_bpm": { "type": "integer", "minimum": 40, "maximum": 180 },
              "key": { "type": "string", "minLength": 1 },
              "duration_s": { "type": "number", "minimum": 5 },
              "chosen_candidate_path": { "type": ["string", "null"] },
              "candidates": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "subtitles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["srt_path"],
            "properties": {
              "srt_path": { "type": "string", "minLength": 1 },
              "lines": {
                "type": "array",
                "maxItems": 2,
                "items": { "type": "string", "maxLength": 42 }
              }
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "duration_s", "path"],
      "properties": {
        "text": { "type": "string", "minLength": 5 },
        "subtitle": { "type": "string" },
        "duration_s": { "type": "number", "minimum": 2, "maximum": 4 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtitle_safe_area", "transition", "ken_burns_fallback"],
      "properties": {
        "subtitle_safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vertical_margin_v", "horizontal_margin_v", "max_lines", "max_chars_per_line"],
          "properties": {
            "vertical_margin_v": { "type": "integer", "minimum": 40 },
            "horizontal_margin_v": { "type": "integer", "minimum": 20 },
            "max_lines": { "type": "integer", "const": 2 },
            "max_chars_per_line": { "type": "integer", "minimum": 30, "maximum": 44 }
          }
        },
        "transition": { "type": "string", "enum": ["cut", "crossfade"] },
        "ken_burns_fallback": { "type": "boolean" }
      }
    }
  }
}

